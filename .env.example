# Same variable names as Hello-Agents chapter 4, section 4.1.
# Put your API key in .env locally, never in chat or source code.
LLM_PROVIDER="qwen"

# OpenAI (keeps the textbook's LLM_* variable names)
LLM_API_KEY="YOUR-API-KEY"
LLM_MODEL_ID="YOUR-MODEL-ID"
LLM_BASE_URL="https://api.openai.com/v1"

# Qwen / Alibaba Cloud Model Studio: China (Beijing), standard API key
DASHSCOPE_API_KEY="YOUR-API-KEY"
QWEN_MODEL_ID="qwen4-max"
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
